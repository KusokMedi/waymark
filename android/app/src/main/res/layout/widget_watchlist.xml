<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="12dp"
    android:background="@android:color/transparent">

    <!-- Header: Waymark title + status + refresh button -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="8dp">

        <!-- Title and status -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/widget_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Waymark"
                android:textSize="13sp"
                android:textStyle="bold"
                android:textColor="#E8F0EB" />

            <TextView
                android:id="@+id/widget_status"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Syncing..."
                android:textSize="11sp"
                android:textColor="#A4B4AB" />
        </LinearLayout>

        <!-- Refresh button -->
        <ImageButton
            android:id="@+id/widget_btn_refresh"
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:background="@drawable/widget_button_background"
            android:src="@drawable/ic_widget_refresh"
            android:contentDescription="@string/widget_refresh_button"
            android:scaleType="centerInside"
            android:tint="#E8F0EB" />
    </LinearLayout>

    <!-- Countries list using StackView for dynamic content -->
    <StackView
        android:id="@+id/widget_stack"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:loopViews="true" />

</LinearLayout>
