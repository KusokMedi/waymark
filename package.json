{
  "name": "waymark",
  "version": "1.0.0",
  "private": true,
  "description": "Local-first Android app for official U.S. Department of State travel advisories.",
  "workspaces": [
    "app",
    "website"
  ],
  "scripts": {
    "dev:website": "npm --workspace website run dev",
    "build": "npm run build:website && npm run assemble",
    "build:website": "npm --workspace website run build",
    "assemble": "node scripts/assemble.mjs",
    "typecheck": "npm --workspace website run typecheck",
    "test": "npm --workspace app run test"
  },
  "engines": {
    "node": ">=20"
  }
}
